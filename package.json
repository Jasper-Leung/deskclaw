{
  "name": "deskclaw",
  "version": "0.3.0",
  "type": "module",
  "description": "Local-first, privacy-focused AI Agent desktop application",
  "main": "dist-electron/main/index.js",
  "author": "Jasper-Leung",
  "license": "MIT",
  "homepage": "https://github.com/Jasper-Leung/deskclaw#readme",
  "bugs": "https://github.com/Jasper-Leung/deskclaw/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jasper-Leung/deskclaw.git"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "desktop",
    "nextjs",
    "llm",
    "workflow",
    "automation"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "cd next && next dev",
    "dev:electron": "npm run build:electron && node wait-for-next.mjs",
    "dev:fast": "cd next && next dev & sleep 15 && npm run build:electron && electron .",
    "build:next": "cd next && next build",
    "build:electron": "node build-electron.js",
    "build": "npm run build:electron && npx rimraf next/.next && cd next && npx next build && cd ..",
    "build:portable": "node scripts/build-portable.js",
    "build:portable:bat": "scripts\\build-portable.bat",
    "build:portable:dir": "npm run build && electron-builder --win --x64 --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "chrome:check": "node scripts/check-chrome-debug.js",
    "chrome:start": "node scripts/start-chrome-debug.js",
    "chrome:start:bat": "scripts\\start-chrome-debug.bat"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.9",
    "@ai-sdk/openai": "^1.1.11",
    "@jimp/gif": "^0.22.12",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nut-tree/nut-js": "^3.1.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.14.1",
    "@types/ws": "^8.18.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "@xyflow/react": "^12.4.4",
    "ai": "^4.1.26",
    "better-sqlite3": "^11.8.1",
    "botbuilder": "^4.23.3",
    "botbuilder-stdlib": "4.23.3-internal",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "discord.js": "^14.25.1",
    "glob": "^13.0.6",
    "grammy": "^1.41.1",
    "js-tiktoken": "^1.0.21",
    "keytar": "^7.9.0",
    "lucide-react": "^0.469.0",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-std-serializers": "^7.1.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vfile-matter": "^5.0.1",
    "ws": "^8.19.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.1.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.15",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "next": "^15.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.deskclaw.app",
    "productName": "DeskClaw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "next/.next/**/*",
      "next/app/**/*",
      "next/components/**/*",
      "next/lib/**/*",
      "next/public/**/*",
      "node_modules/**/*"
    ],
    "asar": false,
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DeskClaw-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "next/public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "next/public/icon.png"
    }
  }
}
