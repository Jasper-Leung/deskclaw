# DeskClaw Environment Variables Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application Environment
# ===========================================
NODE_ENV=development
# Options: development | production

# ===========================================
# Server Configuration
# ===========================================
# Next.js server port (default: 3000)
NEXT_PORT=3000

# ===========================================
# Security Configuration
# ===========================================
# Encryption key for API keys (AES-256-GCM)
# Generate a secure 64-character hex string
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this key safe! If you lose it, all encrypted API keys will be inaccessible.
DESKCLAW_ENCRYPTION_KEY=

# ===========================================
# Optional: System Configuration
# ===========================================
# Timezone for scheduled tasks (default: system timezone)
TZ=UTC

# ===========================================
# Optional: AI Provider Configuration
# ===========================================
# Note: These providers are configured through the application UI
# You can optionally set defaults here for development

# OpenAI API Key (optional)
# OPENAI_API_KEY=

# Anthropic API Key (optional)
# ANTHROPIC_API_KEY=

# ===========================================
# Optional: Development Settings
# ===========================================
# Enable debug logging
# DEBUG=deskclaw:*

# Database path (default: app data directory)
# DATABASE_PATH=

# Enable hot reload (development only)
# HOT_RELOAD=true
